// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// model untuk tabel User
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relasi: Satu user bisa memiliki banyak buku
  books     Book[]
}

// model untuk tabel buku di database PostgreSQL
model Book {
  id        Int      @id @default(autoincrement())
  title     String
  author    String
  status    String   @default("unread") // Nilai bawaan jika tidak diisi: unread, reading, completed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  coverUrl    String?
  // Core Tracker halaman membaca
  startPage   Int @default(0)
  endPage     Int @default(0)
  currentPage Int @default(0) // Posisi halaman terakhir yang dibaca

  // kolom penampung ID pemilik buku
  userId  Int

  // definisi relasi ke tabel User
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}



